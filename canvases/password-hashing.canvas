{
	"nodes":[
		{"id":"grp_reg","type":"group","x":-920,"y":-800,"width":680,"height":960,"label":"Registration & Storage"},
		{"id":"grp_ver","type":"group","x":80,"y":-800,"width":550,"height":1020,"label":"Login Verification"},
		{"id":"grp_rt_good","type":"group","x":-130,"y":300,"width":760,"height":460,"color":"4","label":"With Unique Salt — Protected"},
		{"id":"grp_rt_bad","type":"group","x":-910,"y":300,"width":690,"height":460,"color":"1","label":"Without Salt — Vulnerable"},
		{"id":"v_user","type":"text","text":"### 👤 User logs in\nEnters password: `hunter2`","x":120,"y":-760,"width":280,"height":100,"color":"5"},
		{"id":"v_salt","type":"text","text":"### Retrieve stored salt\nfor this username from database","x":120,"y":-630,"width":280,"height":100,"color":"4"},
		{"id":"v_concat","type":"text","text":"### 🔗 Concatenate\ninput + stored salt\n`hunter2` + `x7k2m9`","x":120,"y":-500,"width":280,"height":130},
		{"id":"v_hash","type":"text","text":"### Same hash function\nSame algorithm — same iterations","x":120,"y":-360,"width":280,"height":120,"color":"2"},
		{"id":"v_digest","type":"text","text":"### Computed digest\n`$2b$12$XxXxXxX...`","x":120,"y":-230,"width":280,"height":100,"color":"1"},
		{"id":"r_user","type":"text","text":"### 👤 User registers\nEnters password: `hunter2`","x":-540,"y":-760,"width":280,"height":100,"color":"5"},
		{"id":"r_concat","type":"text","text":"### 🔗 Concatenate\npassword + salt\n`hunter2x7k2m9`","x":-910,"y":-500,"width":280,"height":130},
		{"id":"r_salt","type":"text","text":"### 🎲 Generate random salt\n`x7k2m9`\n\nUnique per user — generated fresh at account creation","x":-910,"y":-717,"width":280,"height":175,"color":"6"},
		{"id":"v_compare","type":"text","text":"### ⚖️ Compare digests\ncomputed hash vs stored hash","x":120,"y":-100,"width":280,"height":100,"color":"3"},
		{"id":"rt_a1","type":"text","text":"User A: `abc123`","x":-880,"y":330,"width":200,"height":70,"color":"1"},
		{"id":"rt_b1","type":"text","text":"User B: `abc123`","x":-880,"y":440,"width":200,"height":70,"color":"1"},
		{"id":"rt_sha","type":"text","text":"SHA-256\n*(no salt)*","x":-640,"y":375,"width":160,"height":100,"color":"1"},
		{"id":"rt_same","type":"text","text":"**Both hash to:**\n`ef92b7...`\n\nIDENTICAL","x":-420,"y":375,"width":170,"height":160,"color":"1"},
		{"id":"rt_crack","type":"text","text":"☠️ One rainbow table\ncracks **both accounts**\ninstantly","x":-540,"y":565,"width":240,"height":120,"color":"1"},
		{"id":"v_rejected","type":"text","text":"## ❌ LOGIN REJECTED\nGeneric error only — never reveal why","x":420,"y":50,"width":210,"height":110,"color":"1"},
		{"id":"v_granted","type":"text","text":"## ✅ LOGIN GRANTED","x":120,"y":70,"width":200,"height":80,"color":"4"},
		{"id":"r_db","type":"text","text":"### 🗄️ Database stores\n\n✅ username\n✅ hash digest\n✅ salt\n\n❌ NOT the plaintext password","x":-500,"y":-360,"width":240,"height":240,"color":"4"},
		{"id":"r_hash","type":"text","text":"### Hash function\nbcrypt / PBKDF2","x":-910,"y":-330,"width":280,"height":100,"color":"2"},
		{"id":"r_digest","type":"text","text":"### Final digest\n`$2b$12$XxXxXxX...`","x":-910,"y":60,"width":280,"height":100,"color":"1"},
		{"id":"rt_banner","type":"text","text":"## ⚡ Why Salting Defeats Rainbow Tables","x":-910,"y":180,"width":1540,"height":70,"color":"3"},
		{"id":"insight","type":"text","text":"### ⚠️ Hashing is ONE-WAY\n\nThe system never decrypts.\n\nAt login it re-hashes the input with the stored salt and compares. Decryption is **impossible** by design.\n\nThis is why a forgotten password must be **reset**, not **recovered**.","x":-200,"y":-100,"width":240,"height":320,"color":"3"},
		{"id":"rt_a2","type":"text","text":"User A: `abc123` + `salt_A`","x":-90,"y":360,"width":240,"height":70,"color":"4"},
		{"id":"rt_b2","type":"text","text":"User B: `abc123` + `salt_B`","x":-90,"y":460,"width":240,"height":70,"color":"4"},
		{"id":"rt_bcrypt","type":"text","text":"bcrypt\n*(unique salts)*","x":190,"y":400,"width":160,"height":100,"color":"4"},
		{"id":"rt_diff","type":"text","text":"Hash A: `x9k2m3...`\nHash B: `p7n4q1...`\n\nDIFFERENT","x":420,"y":390,"width":200,"height":160,"color":"4"},
		{"id":"rt_safe","type":"text","text":"🛡️ Rainbow tables useless\nMust brute-force each\naccount separately","x":220,"y":580,"width":250,"height":110,"color":"4"},
		{"id":"r_stretch","type":"text","text":"### 🔄 Key stretching\nRepeat hashing ~60,000×\n\nIntentionally slow — adds negligible time for the user but makes brute-force attacks take centuries","x":-910,"y":-215,"width":280,"height":230,"color":"2"}
	],
